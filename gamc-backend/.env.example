# ==========================================
# gamc-backend — Variables de Entorno (Ejemplo)
# ==========================================

# Puerto del servidor Express
PORT=4000

# Conexión a PostgreSQL (Prisma ORM)
# En Docker Compose, el host es "db" (nombre del servicio)
DATABASE_URL="postgresql://postgres:huevos123@db:5432/gamc_db?schema=public"

# Ollama LLM — Clasificación de denuncias
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gamc-clasificador

# Whisper STT — Transcripción de voz
WHISPER_URL=http://whisper:5000/transcribe
