# ==========================================
# ProyectoCallCenter - Root GitIgnore
# ==========================================

# Environment variables & secrets
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
!*.env.example

# Dependencies
node_modules/
**/node_modules/

# Build outputs & binaries
dist/
**/dist/
bin/
**/bin/
obj/
**/obj/
build/
**/build/
dist-ssr/
**/dist-ssr/

# Python
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Local uploads & dynamic data
uploads/
**/uploads/
*.sqlite

# Docker persistent local volumes
pgdata/
**/pgdata/
ollama_data/
**/ollama_data/

# IDEs, Editors & OS Metadata
.vs/
**/.vs/
.vscode/
**/.vscode/
!.vscode/extensions.json
.idea/
**/.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db

# Logs & Debugging
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
debug.log

# Testing & Coverage
coverage/
**/coverage/
.nyc_output/
