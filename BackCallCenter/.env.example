# Server
PORT=3000
NODE_ENV=development

# CORS — URL del frontend principal
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL en Docker)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dbCallCenter

# JWT — Cambiar por un string seguro en producción
JWT_SECRET=tu_clave_secreta_jwt_para_desarrollo
JWT_EXPIRES_IN=8h

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASSWORD=tu_contraseña_de_aplicacion

# CochaExacta — API de Reverse Geocoding (Docker DNS)
COCHAEXACTA_URL=http://cochaexacta:5011

# Storage — Ruta para subir archivos
MAX_FILE_SIZE=5
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp