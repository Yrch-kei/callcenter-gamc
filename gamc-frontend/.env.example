# URL base del Backend GAMC (Node.js/Express)
VITE_API_URL=http://localhost:4000/api/v1

# Conexión WebSocket (actualizaciones en vivo)
VITE_WS_URL=ws://localhost:4000

# URL del microservicio Whisper (transcripción de voz)
VITE_WHISPER_URL=http://localhost:5000/transcribe
